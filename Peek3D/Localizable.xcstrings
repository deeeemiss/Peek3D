    "error.gltfInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This glTF file is damaged or uses an invalid structure, so it can't be opened."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file glTF è danneggiato o ha una struttura non valida, quindi non può essere aperto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo glTF está dañado o tiene una estructura no válida, así que no se puede abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier glTF est endommagé ou sa structure n’est pas valide : impossible de l’ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese glTF-Datei ist beschädigt oder ungültig aufgebaut und kann nicht geöffnet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo glTF está danificado ou tem uma estrutura inválida, por isso não pode ser aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл glTF повреждён или имеет недопустимую структуру, поэтому его нельзя открыть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف glTF هذا تالف أو بنيته غير صالحة، لذا لا يمكن فتحه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この glTF ファイルは破損しているか構造が無効なため、開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 glTF 파일은 손상되었거나 구조가 올바르지 않아 열 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 glTF 文件已损坏或结构无效，无法打开。"
          }
        }
      }
    },
