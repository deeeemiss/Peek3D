    "licenseSheet.error.futureSchema": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key requires a newer version of Peek3D. Update the app and try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave richiede una versione più recente di Peek3D. Aggiorna l'app e riprova."
          }
        }
      }
    },
    "licenseSheet.error.malformed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This doesn't look like a valid license key. Make sure you copied the entire string from the email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa non sembra una chiave di licenza valida. Controlla di aver copiato l'intera stringa dall'email."
          }
        }
      }
    },
    "licenseSheet.error.signatureInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key's signature isn't valid. If you typed it in by hand, try pasting it directly from the original email instead."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma della chiave non è valida. Se l'hai digitata a mano, prova a incollarla direttamente dall'email originale."
          }
        }
      }
    },
    "licenseSheet.error.wrongProduct": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key belongs to a different product, not Peek3D."
