    "trialGate.remoteBlocked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's license activation was reported as revoked, and more than 72 hours have passed since then. Your license key itself is still recognized — only the online activation check failed. If this looks wrong, contact peek3d@sebdemichelis.dev."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attivazione della licenza su questo Mac risulta revocata, e sono passate più di 72 ore da allora. La chiave di licenza in sé è ancora riconosciuta valida — è solo il controllo online dell'attivazione ad aver fallito. Se pensi sia un errore, scrivi a peek3d@sebdemichelis.dev."
          }
        }
      }
    },
