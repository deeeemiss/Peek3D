    },
    "error.remoteBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license's activation was revoked and the grace period has ended — this file can't be opened until it's resolved."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attivazione di questa licenza è stata revocata e il periodo di tolleranza è terminato — questo file non può essere aperto finché il problema non viene risolto."
          }
        }
      }
    },
    "error.trialExhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial limit reached — this file can't be opened."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di prova raggiunto — questo file non può essere aperto."
          }
        }
      }
    },
