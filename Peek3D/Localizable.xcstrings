          "stringUnit": {
            "state": "translated",
            "value": "Hai aperto tutti i file inclusi nella prova (%lld/%lld). Il file che hai provato ad aprire non è andato perso: resta dove si trova, potrai riaprirlo appena sblocchi Peek3D."
          }
        }
      }
