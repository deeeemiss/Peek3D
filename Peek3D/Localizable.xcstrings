    "settings.viewer.defaults.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting values for every file you open. Windows already open keep their current look."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori di partenza per ogni file che apri. Le finestre già aperte restano come sono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores iniciales para cada archivo que abras. Las ventanas ya abiertas mantienen su aspecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs de départ pour chaque fichier ouvert. Les fenêtres déjà ouvertes gardent leur apparence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startwerte für jede geöffnete Datei. Bereits geöffnete Fenster behalten ihr Aussehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores iniciais para cada arquivo aberto. Janelas já abertas mantêm a aparência atual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開くたびに使われる初期値です。すでに開いているウインドウは変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打开文件时使用的初始值。已打开的窗口保持不变。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 열 때마다 쓰이는 초깃값입니다. 이미 열린 윈도우는 그대로 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начальные значения для каждого открываемого файла. Уже открытые окна не меняются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيم البداية لكل ملف تفتحه. النوافذ المفتوحة مسبقًا تحتفظ بمظهرها الحالي."
          }
        }
      }
    },
