    "activation.banner.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license's activation was revoked more than 72 hours ago. New files can no longer be opened — contact peek3d@sebdemichelis.dev if this looks wrong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attivazione di questa licenza è stata revocata più di 72 ore fa. Non è più possibile aprire nuovi file — scrivi a peek3d@sebdemichelis.dev se pensi sia un errore."
          }
        }
      }
    },
    "activation.banner.deviceConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license is already active on another Mac. If that's you, open Peek3D there, go to Settings, and deactivate it — then come back here and retry."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza risulta già attiva su un altro Mac. Se sei tu, apri Peek3D su quel Mac, vai in Impostazioni e disattivalo — poi torna qui e riprova."
          }
        }
      }
    },
    "activation.banner.offlineGraceExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peek3D hasn't been able to verify your license online in over 30 days. Connect to the internet briefly to keep using it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peek3D non riesce a verificare la tua licenza online da più di 30 giorni. Connettiti a internet per qualche istante per continuare a usarlo."
          }
        }
      }
    },
    "activation.banner.remainingTransfers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld free reactivation left."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld free reactivations left."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ti resta %lld riattivazione gratuita."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ti restano %lld riattivazioni gratuite."
                }
              }
            }
          }
        }
      }
    },
    "activation.banner.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        }
      }
    },
    "activation.banner.revokedGrace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license was reported as revoked. Peek3D keeps working normally until %@ — contact peek3d@sebdemichelis.dev if this looks wrong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua licenza risulta revocata. Peek3D continua a funzionare normalmente fino al %@ — scrivi a peek3d@sebdemichelis.dev se pensi sia un errore."
          }
        }
      }
    },
    "dropzone.chooseShort": {
