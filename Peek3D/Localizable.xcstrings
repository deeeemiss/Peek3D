    "folderAccess.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the folder that contains “%@” to enable its external textures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona la cartella che contiene «%@» per abilitarne le texture esterne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona la carpeta que contiene «%@» para activar sus texturas externas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le dossier qui contient « %@ » pour activer ses textures externes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit „%@“ aus, um seine externen Texturen zu aktivieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione a pasta que contém “%@” para ativar as texturas externas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку с файлом «%@», чтобы включить его внешние текстуры."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المجلد الذي يحتوي على «%@» لتفعيل الخامات الخارجية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部テクスチャを有効にするには、「%@」を含むフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 텍스처를 사용하려면 “%@” 파일이 들어 있는 폴더를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含“%@”的文件夹以启用其外部纹理。"
          }
        }
      }
    },
    "error.openFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file couldn't be opened. It may be damaged or use a feature Peek3D doesn't support yet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire questo file. Potrebbe essere danneggiato o usare una funzione che Peek3D non supporta ancora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir este archivo. Puede estar dañado o usar una función que Peek3D aún no admite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ce fichier. Il est peut-être endommagé ou utilise une fonction que Peek3D ne prend pas encore en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht geöffnet werden. Sie ist eventuell beschädigt oder nutzt eine Funktion, die Peek3D noch nicht unterstützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir este arquivo. Ele pode estar danificado ou usar um recurso que o Peek3D ainda não suporta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть этот файл. Возможно, он повреждён или использует функцию, которую Peek3D пока не поддерживает."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذا الملف. ربما يكون تالفًا أو يستخدم ميزة لا يدعمها Peek3D بعد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを開けませんでした。破損しているか、Peek3D がまだ対応していない機能を使っている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 열 수 없습니다. 손상되었거나 Peek3D가 아직 지원하지 않는 기능을 사용하는 파일일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此文件。它可能已损坏，或使用了 Peek3D 尚不支持的功能。"
          }
        }
      }
    },
