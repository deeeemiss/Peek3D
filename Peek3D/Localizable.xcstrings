            "value": "“System language” follows the order set in System Settings ▸ General ▸ Language & Region."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Lingua di sistema” segue l'ordine scelto in Impostazioni di Sistema ▸ Generali ▸ Lingua e Regione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Idioma del sistema” sigue el orden definido en Ajustes del Sistema ▸ General ▸ Idioma y región."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Langue du système » suit l’ordre défini dans Réglages Système ▸ Général ▸ Langue et région."
          }
        },
        "de": {
          "stringUnit": {
