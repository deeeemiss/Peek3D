    "settings.about.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a 3D file. Look at it. Free and open source under the MIT license."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un file 3D. Guardalo. Gratuito e open source con licenza MIT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un archivo 3D. Míralo. Gratis y de código abierto con licencia MIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un fichier 3D. Regardez-le. Gratuit et open source sous licence MIT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-Datei ablegen. Ansehen. Kostenlos und Open Source unter MIT-Lizenz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte um arquivo 3D. Veja. Gratuito e de código aberto sob licença MIT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3Dファイルをドロップして、見るだけ。MITライセンスの無料オープンソース。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入一个 3D 文件，直接查看。基于 MIT 许可的免费开源软件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 파일을 놓고, 보기만 하세요. MIT 라이선스의 무료 오픈 소스입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите 3D-файл. Смотрите. Бесплатно и с открытым кодом по лицензии MIT."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت ملفًا ثلاثي الأبعاد. شاهده. مجاني ومفتوح المصدر بترخيص MIT."
          }
        }
      }
    },
